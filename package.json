{
  "name": "cogit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "tsx scripts/spike.ts",
    "cogit": "tsx packages/cli/src/index.ts",
    "build": "node scripts/build.mjs",
    "build:frontend": "pnpm --filter @cogit/frontend build",
    "viewer": "pnpm --filter @cogit/frontend start",
    "dev:viewer": "pnpm --filter @cogit/frontend dev",
    "test": "vitest run"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "dotenv": "18.0.8",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
