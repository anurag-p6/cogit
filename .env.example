# Arkiv Tiramisu testnet (chain ID 7738577, 2s blocks)
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Primary funded wallet (spike: create/update/query owner)
PRIVATE_KEY=0x<funded-tiramisu-private-key>

# Second funded wallet (spike: non-owner update must fail)
PRIVATE_KEY_2=0x<second-funded-tiramisu-private-key>
